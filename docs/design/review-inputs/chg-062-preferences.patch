diff --git a/tools/serialize-static-page.mjs b/tools/serialize-static-page.mjs
new file mode 100644
index 0000000..1bd6361
--- /dev/null
+++ b/tools/serialize-static-page.mjs
@@ -0,0 +1,6 @@
+import {parseFragment} from 'parse5';
+/** Build-only serialization of our typed page, never user or stored markup. */
+export function serializeStaticPage(html) {
+ const encode=node=>node.nodeName==='#text'?node.value:[node.tagName,node.attrs.map(a=>[a.name,a.value]),node.childNodes.map(encode)];
+ return JSON.stringify(parseFragment(html).childNodes.map(encode)).replaceAll('<','\\u003c');
+}
