+    tx.onerror = () => reject(context.error || tx.error);
+    tx.onabort = () => reject(context.error || tx.error || new Error('Database transaction aborted.'));
+    try { action(tx, context); }
+    catch (error) { context.fail(error); }
+  }).finally(() => db.close()));
+}
