-.session-sequence { margin:0 0 19px; flex-direction:row; gap:6px; }
-.session-sequence .drill-step { min-width:0; max-width:100%; padding:8px; font-size:.75rem; overflow-wrap:anywhere; }
-.session-config-form { display:grid; gap:12px; }
-.session-config-fields { display:grid; gap:12px; padding:0; margin:0; border:0; min-width:0; }
-.session-config-fields legend { color:var(--session-muted); font-size:.7rem; letter-spacing:.08em; text-transform:uppercase; padding:0 0 12px; }
