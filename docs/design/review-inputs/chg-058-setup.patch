-.session-repetition-field { display:flex; justify-content:space-between; align-items:center; padding:13px; border:1px solid var(--session-border); border-radius:12px; background:var(--session-surface); font-weight:700; }
-.session-repetition-field input { width:86px; text-align:center; }
-.session-delay-card { display:grid; gap:13px; padding:13px; border:1px solid var(--session-border); border-radius:12px; background:var(--session-surface); }
-.session-delay-card>.session-field { display:flex; align-items:center; justify-content:space-between; font-weight:700; }
-.session-delay-card>.session-field select { width:55%; }
-.session-delay-card>.muted { margin:0; font-size:.72rem; }
 .session-delay-range { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
 .preference-toggle { display:flex; align-items:center; justify-content:space-between; gap:14px; min-height:64px; padding:14px; color:var(--session-text); cursor:pointer; }
 .preference-toggle>span { display:grid; gap:5px; min-width:0; }
