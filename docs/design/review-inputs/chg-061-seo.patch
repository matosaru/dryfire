+import type {ReactNode} from 'react';
+import {InformationCard} from '@dryfire/ui/InformationCard';
+// @ts-expect-error Shared runtime mode registry remains JavaScript.
+import {PRACTICE_MODES} from '../../../../../src/practiceModes.js';
