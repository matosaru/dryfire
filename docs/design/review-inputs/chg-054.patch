+// Retired catalog modes remain reachable through supported saved-session flows.
+import { createPractice, endPractice, toPracticeRecord, practiceDefinition } from '../src/practiceSession.js';
+export function addLegacyPractices(backup) {
+  const gun = backup.guns.find(item => item.id === backup.activeGunId);
+  for (const mode of ['reload', 'free']) {
+    const state = createPractice({ id: `legacy-${mode}-review`, gun, mode,
+      monoNow: 0, epochNow: Date.parse('2026-10-11T10:00:00Z') });
+    backup.sessions.push(toPracticeRecord(endPractice(state, { monoNow: 0, epochNow: state.startedAt })));
+  }
+}
+export async function openPractice(page, mode = 'single') {
+  if (['reload', 'free'].includes(mode)) {
+    await page.locator('.tab[data-view="history"]').click();
+    await page.locator('#savedSessions .saved-session-card').filter({ has: page.getByText(practiceDefinition(mode).title, { exact: true }) }).getByRole('button').click();
+    await page.locator('#practiceRepeatBtn').click();
+  } else {
+    await page.locator('.tab[data-view="drills"]').click();
+    await page.locator(`[data-practice-mode="${mode}"]`).click();
+  }
+  await page.locator('#practiceConfigure').waitFor({ state: 'visible' });
+}
