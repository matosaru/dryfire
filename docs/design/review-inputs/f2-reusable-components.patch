diff --git a/packages/ui/src/GunContext/GunContext.test.tsx b/packages/ui/src/GunContext/GunContext.test.tsx
new file mode 100644
index 0000000..0d1a032
--- /dev/null
+++ b/packages/ui/src/GunContext/GunContext.test.tsx
@@ -0,0 +1,12 @@
+/** @jest-environment jsdom */
+import '@dryfire/testing/setup';
+import {cleanup,render,screen} from '@testing-library/react';
+import {GunContext} from './GunContext.tsx';
+afterEach(cleanup);
+test('context wording and escaped gun names preserve a single named child across updates',()=>{
+ const {rerender,container}=render(<GunContext prefix="Practice for " name="<img src=x>"/>);
+ const name=screen.getByText('<img src=x>');expect(container.querySelector('img')).toBeNull();
+ expect(container.querySelector('p')).toHaveTextContent('Practice for <img src=x>.');
+ rerender(<GunContext prefix="Saved results for " name="Second" hidden/>);
+ expect(screen.getByText('Second')).toBe(name);expect(container.querySelector('p')).toHaveClass('gun-context','hidden');
+});
diff --git a/packages/ui/src/GunContext/GunContext.tsx b/packages/ui/src/GunContext/GunContext.tsx
new file mode 100644
index 0000000..d362556
--- /dev/null
+++ b/packages/ui/src/GunContext/GunContext.tsx
@@ -0,0 +1,3 @@
+export type GunContextProps={name?:string;hidden?:boolean;prefix:string;suffix?:string};
+/** Shared text only; the application owns selection, readiness and persistence. */
+export function GunContext({name,hidden=false,prefix,suffix='.'}:GunContextProps){return <p className={'gun-context'+(hidden?' hidden':'')}>{prefix}<strong className="gun-context-name">{name}</strong>{suffix}</p>;}
