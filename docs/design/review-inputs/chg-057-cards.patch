diff --git a/tests/entryPlacement.test.js b/tests/entryPlacement.test.js
new file mode 100644
index 0000000..2237dea
--- /dev/null
+++ b/tests/entryPlacement.test.js
@@ -0,0 +1,15 @@
+import { placeEntryAfterMarkup } from '../tools/place-entry.mjs';
+const entry='<script type="module" crossorigin src="/assets/index-abc_123.js"></script>';
+test('the app module follows complete markup while CSS stays in the head',()=>{
+ const html=`<html><head>${entry}<link rel="stylesheet" href="/assets/theme.css"></head><body><main>Ready</main></body></html>`;
+ expect(placeEntryAfterMarkup(html)).toBe(`<html><head><link rel="stylesheet" href="/assets/theme.css"></head><body><main>Ready</main>${entry}</body></html>`);
+ expect(placeEntryAfterMarkup(placeEntryAfterMarkup(html))).toBe(placeEntryAfterMarkup(html));
+});
+test('non-entry scripts, attributes and an existing body entry remain unchanged',()=>{
+ const html=`<html><head><script type="application/json">{"message":"<tag>"}</script></head><body>${entry}</body></html>`;
+ expect(placeEntryAfterMarkup(html)).toBe(html);
+ expect(placeEntryAfterMarkup('<body>No bundled entry</body>')).toBe('<body>No bundled entry</body>');
+});
+test('ambiguous generated entries fail closed instead of silently reordering unrelated scripts',()=>{
+ expect(()=>placeEntryAfterMarkup(`<head>${entry}${entry}</head><body></body>`)).toThrow('one');
+});
diff --git a/tools/place-entry.mjs b/tools/place-entry.mjs
new file mode 100644
index 0000000..b4315fe
--- /dev/null
+++ b/tools/place-entry.mjs
@@ -0,0 +1,10 @@
+/** Build-only ordering: discover the app after its markup; preserve CSS in head. */
+export function placeEntryAfterMarkup(html) {
+  const head = html.match(/<head\b[^>]*>([\s\S]*?)<\/head>/i);
+  if (!head || !/<\/body\s*>/i.test(html)) return html;
+  const entries = head[1].match(/<script\b(?=[^>]*\btype="module")(?=[^>]*\bsrc="\/assets\/index-[A-Za-z0-9_-]+\.js")[^>]*><\/script>/g) || [];
+  if (!entries.length) return html;
+  if (entries.length !== 1) throw new Error('Expected one bundled application entry.');
+  const nextHead = head[0].replace(entries[0], '');
+  return html.replace(head[0], () => nextHead).replace(/<\/body\s*>/i, close => entries[0] + close);
+}
