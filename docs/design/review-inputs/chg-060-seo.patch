@@ -0,0 +1,9 @@
+/**
+ * @jest-environment jsdom
+ * @jest-environment-options {"customExportConditions":["node","node-addons"]}
+ */
+import '@dryfire/testing/setup';import{render,cleanup}from'@testing-library/react';import{PublicPage,type PublicRoute}from'./PublicPage';
+// @ts-expect-error Build-only JS route registry.
+import{PUBLIC_ROUTES}from'../../../../../site/routes.js';
+afterEach(cleanup);
+test.each(PUBLIC_ROUTES as PublicRoute[])('public $id has semantic initial content and real navigation without personal context',(route)=>{const v=render(<PublicPage route={route} routes={PUBLIC_ROUTES}/>);expect(v.getByRole('heading',{level:1})).toHaveTextContent(route.heading);expect(v.container.querySelectorAll('h1')).toHaveLength(1);expect(v.container.querySelector('.gun-switcher')).toBeNull();expect(v.getByRole('navigation',{name:'Main navigation'}).querySelectorAll('a')).toHaveLength(5);expect(v.getByRole('link',{name:'Open settings'})).toHaveAttribute('href','/app/settings/');expect(v.container.querySelector('script')).toBeNull();});
diff --git a/apps/web/src/public-site/PublicPage/PublicPage.tsx b/apps/web/src/public-site/PublicPage/PublicPage.tsx
new file mode 100644
index 0000000..9173781
--- /dev/null
+++ b/apps/web/src/public-site/PublicPage/PublicPage.tsx
@@ -0,0 +1,25 @@
+import {AppShell} from '@dryfire/ui/AppShell';
+import type {ReactNode} from 'react';
+type Guide={id:string;title:string;purpose:string;measures:string;steps:string[];expect:string;requires:string};
+export type PublicRoute={id:string;path:string;title:string;heading:string;description:string;guide?:Guide};
+export type PublicPageProps={route:PublicRoute;routes:PublicRoute[]};
+const links={home:'/app/',learn:'/app/learn/',drills:'/app/drills/',recognize:'/app/live-listen/',history:'/app/history/',settings:'/app/settings/',about:'/about/',contact:'/contact/'};
+function Panel({title,children}:{title:string;children:ReactNode}){return <section className="public-panel"><h2>{title}</h2>{children}</section>;}
+export function PublicPage({route,routes}:PublicPageProps){
+ const guide=route.guide,modePath=guide?`/app/practice/${route.path.split('/')[2]}/`:'/app/';
+ return <AppShell view={['about','contact'].includes(route.id)?route.id:'public'} status="Beta" links={links}>
+  <nav className="public-top-links" aria-label="Public pages"><a href="/">Home</a><a href="/practice/">Practice modes</a><a href="/help/">Help</a></nav>
+  <article id="public-content" className="public-article"><p className="public-kicker">{guide?'PRACTICE GUIDE':'DRY FIRE WITH EASE · BETA'}</p><h1>{route.heading}</h1><p className="public-intro">{route.description}</p>
+  {route.id==='home'&&<><a className="button primary public-start" href="/app/">Open the free app</a><Panel title="A simple practice routine"><ol><li>Add a gun and learn its trigger click.</li><li>Choose a practice mode, confirm safety and wait for the signal.</li><li>Review your recognized clicks and saved timings.</li></ol><p>No account or payment details are required. The public version creates up to two guns and keeps compatible existing profiles.</p></Panel></>}
+  {['home','practice'].includes(route.id)&&<Panel title="Four ways to practice"><div className="public-mode-list">{routes.filter(r=>r.guide).map(item=><a key={item.path} href={item.path}><strong>{item.heading}</strong><span>{item.description}</span><span className="public-read">Read the guide</span></a>)}</div></Panel>}
+  {guide&&<><Panel title="What it measures"><p>{guide.measures}</p></Panel><p><a href={`/guide-examples/${guide.id}.gif`}>View the silent animated example</a></p><p className="muted small">Synthetic detections at 1× timing; no live microphone. Opens the exported example, which stops at Review.</p><Panel title="How it works"><ol>{guide.steps.map(step=><li key={step}>{step}</li>)}</ol></Panel><Panel title="Good to know"><p>{guide.expect}</p><p>{guide.requires}</p></Panel><a className="button primary public-start" href={modePath}>Configure this practice</a><p className="muted small">The app asks for a gun and compatible trigger examples before practice. Opening this guide never starts your microphone.</p></>}
+  {route.id==='sequence'&&<><Panel title="Built-in sequences"><ul><li>Rack slide → Trigger pull</li><li>Magazine change → Trigger pull</li><li>Draw from holster → Magazine change → Trigger pull</li></ul><p>Learn each distinct sound required by the selected sequence. Other sound categories remain optional.</p></Panel><Panel title="How a repetition works"><ol><li>Choose a sequence, repetitions and fixed or random ready delay.</li><li>Confirm safety, wait for the start signal and perform the sequence.</li><li>The app advances only on recognized sounds in the expected order, saves each result and starts the next countdown.</li></ol><p>Timings describe detected audio, not verified physical actions. With the sequence start beep on, the first 0.30 seconds after GO are excluded to reject the cue.</p></Panel><a className="button primary public-start" href="/app/drills/">Choose a sequence</a></>}
+  {route.id==='calibration'&&<><Panel title="Record useful examples"><ol><li>Confirm the firearm is unloaded and complete the app safety check.</li><li>In Learn, select Trigger pull and record separate, clear examples for the active gun. At least three compatible examples are needed; up to ten are allowed per type.</li><li>Test recognition in your actual room and device position. Optional reset/noise examples can help reject similar clicks.</li></ol></Panel><Panel title="If clicks are missed"><p>Confirm microphone permission and watch the live microphone indicator. Keep background noise low and record fresh examples when device placement or audio processing changes. Recognition is experimental and can miss or misclassify sounds.</p></Panel><a className="button primary public-start" href="/app/learn/">Open Learn</a></>}
+  {route.id==='help'&&<><Panel title="Microphone and recognition"><p>Open the app over HTTPS, allow microphone permission and learn your selected gun’s trigger sound. Capture runs while the app is open; switching away stops it. The level indicator helps confirm input is reaching the app.</p><a href="/guides/trigger-click-calibration/">Read the calibration guide</a></Panel><Panel title="iPhone Home Screen"><ol><li>Open easydryfire.com/app/ in Safari.</li><li>Tap Share, then Add to Home Screen.</li><li>Open the installed app and allow microphone permission when starting capture.</li></ol><p>Noise Filter, Auto Gain and vibration depend on browser/device capabilities. Settings explains unsupported controls. Raise device volume if the start beep is quiet.</p></Panel><Panel title="Keep a recovery copy"><p>Use Settings → Export backup before clearing browser data, changing device or moving domain. Import replaces the current local library after confirmation. A redirect does not transfer data between .app, .com or workers.dev.</p><a href="/app/settings/">Open Settings</a></Panel></>}
+  {route.id==='about'&&<><Panel title="Feedback welcome"><p>Dry Fire With Ease is a Beta sound trainer. All feedback and suggestions are welcome.</p><a href="/contact/">Contact us</a></Panel><Panel title="What the free app includes"><p>Trigger-click calibration, four trigger practice modes, built-in sequences, live listening, local history and manual backups. No account is required.</p><p>New public gun profiles are limited to two. Existing saved data remains available; advanced feature availability follows the current public version.</p></Panel></>}
+  {route.id==='contact'&&<Panel title="Email support"><p>Send questions, suggestions or a bug report to:</p><a className="about-email" href="mailto:easydryfire@gmail.com">easydryfire@gmail.com</a><p>Opens your email app. You can also select and copy the address. Do not send private backups or raw recordings unless you deliberately choose to share them.</p></Panel>}
+  <Panel title="Practice responsibly"><p>Verify the firearm is unloaded, remove live ammunition from the practice area and establish a safe direction and backstop. The microphone cannot verify unloaded status, aim, movement or safe handling.</p></Panel>
+  <nav className="public-related" aria-label="More guides"><a href="/guides/sequence-drills/">Sequence drills</a><a href="/guides/trigger-click-calibration/">Calibration</a></nav>
+  </article>
+ </AppShell>;
+}
