{
  "description": "Public easydryfire.app to easydryfire.com — permanent redirect",
  "expression": "(http.host eq \"easydryfire.app\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": {
        "expression": "concat(\"https://easydryfire.com\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
