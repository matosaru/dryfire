{
  "name": "dryfire-sound-trainer",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx ./node_modules/vite/bin/vite.js",
    "build": "node --import tsx ./node_modules/vite/bin/vite.js build",
    "build:preview": "node --import tsx ./node_modules/vite/bin/vite.js build --mode full-preview",
    "dev:preview": "node --import tsx ./node_modules/vite/bin/vite.js --mode full-preview --host 127.0.0.1",
    "preview": "node --import tsx ./node_modules/vite/bin/vite.js preview",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:smoke": "node --import tsx --test tests/smoke.test.mjs tests/installable.test.mjs",
    "build:static": "npm run build",
    "verify:dist": "node tools/verify-dist.mjs",
    "docs:check": "node --import tsx tools/verify-docs.mjs",
    "docs:generate": "node tools/verify-component-packages.mjs --write && node --import tsx tools/verify-docs.mjs --write",
    "docs:review": "node --import tsx tools/verify-docs.mjs --review",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots=all",
    "test:visual:docker": "node tools/visual-docker.mjs",
    "visual:review": "node tools/visual-review.mjs",
    "visual:probe": "node tools/visual-diff-probe.mjs",
    "deploy:check": "npm run verify:dist && npm run verify:profile && wrangler deploy --config wrangler.jsonc --dry-run",
    "deploy:production": "node tools/verify-dist.mjs --edition=public && wrangler deploy --config wrangler.public.jsonc --env \"\"",
    "deploy:development": "node tools/verify-dist.mjs --edition=public && wrangler deploy --config wrangler.public.jsonc --env dev",
    "private-preview:check": "node tools/verify-dist.mjs --edition=preview && wrangler deploy --config wrangler.private-preview.jsonc --dry-run",
    "deploy:private-preview": "node tools/verify-dist.mjs --edition=preview && wrangler deploy --config wrangler.private-preview.jsonc",
    "build:public": "node --import tsx ./node_modules/vite/bin/vite.js build --mode public",
    "dev:public": "node --import tsx ./node_modules/vite/bin/vite.js --mode public --host 127.0.0.1",
    "verify:profile": "node tools/verify-build-profile.mjs",
    "typecheck": "tsc --noEmit",
    "verify:architecture": "node tools/verify-component-packages.mjs",
    "coverage:check": "node tools/verify-coverage.mjs",
    "perf:payload": "node --experimental-vm-modules tools/performance/check-payload.mjs",
    "perf:compare": "node --experimental-vm-modules tools/performance/measure-browser.mjs",
    "perf:react-shell": "node tools/performance/probe-react-shell.mjs",
    "lint:components": "eslint apps packages",
    "lint:runtime": "eslint src workers"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "jose": "6.2.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-jest": "30.5.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.4",
    "html-minifier-terser": "7.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "30.5.2",
    "parse5": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.1",
    "wrangler": "4.149.0"
  },
  "workspaces": [
    "apps/web",
    "packages/ui",
    "packages/testing"
  ]
}
