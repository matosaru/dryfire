{
  "name": "dryfire-sound-trainer",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:preview": "vite build --mode full-preview",
    "dev:preview": "vite --mode full-preview --host 127.0.0.1",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:smoke": "node --test tests/smoke.test.mjs tests/installable.test.mjs",
    "build:static": "npm run build",
    "verify:dist": "node tools/verify-dist.mjs",
    "docs:check": "node tools/verify-docs.mjs",
    "docs:generate": "node tools/verify-docs.mjs --write",
    "docs:review": "node tools/verify-docs.mjs --review",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots=all",
    "test:visual:docker": "node tools/visual-docker.mjs",
    "visual:review": "node tools/visual-review.mjs",
    "visual:probe": "node tools/visual-diff-probe.mjs",
    "deploy:check": "npm run verify:dist && npm run verify:profile && wrangler deploy --config wrangler.jsonc --dry-run",
    "deploy:production": "node tools/verify-dist.mjs --edition=public && wrangler deploy --config wrangler.public.jsonc --env \"\"",
    "deploy:development": "node tools/verify-dist.mjs --edition=public && wrangler deploy --config wrangler.public.jsonc --env dev",
    "private-preview:check": "node tools/verify-private-deploy-target.mjs && node tools/verify-dist.mjs --edition=preview && wrangler deploy --config wrangler.private-preview.jsonc --dry-run",
    "deploy:private-preview": "node tools/verify-private-deploy-target.mjs && node tools/verify-dist.mjs --edition=preview && wrangler deploy --config wrangler.private-preview.jsonc",
    "build:public": "vite build --mode public",
    "dev:public": "vite --mode public --host 127.0.0.1",
    "verify:profile": "node tools/verify-build-profile.mjs",
    "verify:private-target": "node tools/verify-private-deploy-target.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@playwright/test": "1.58.2",
    "fake-indexeddb": "^6.2.4",
    "jest": "^30.2.0",
    "vite": "^8.3.1",
    "wrangler": "4.149.0"
  }
}
