{
  "name": "dryfire-sound-trainer",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:smoke": "node --test tests/smoke.test.mjs tests/installable.test.mjs",
    "build:static": "npm run build",
    "verify:dist": "node tools/verify-dist.mjs",
    "docs:check": "node tools/verify-docs.mjs",
    "docs:generate": "node tools/verify-docs.mjs --write",
    "docs:review": "node tools/verify-docs.mjs --review",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots=all",
    "test:visual:docker": "node tools/visual-docker.mjs",
    "visual:review": "node tools/visual-review.mjs",
    "visual:probe": "node tools/visual-diff-probe.mjs",
    "deploy:check": "wrangler deploy --config wrangler.jsonc --env \"\" --dry-run && wrangler deploy --config wrangler.jsonc --env dev --dry-run",
    "deploy:production": "wrangler deploy --config wrangler.jsonc --env \"\"",
    "deploy:development": "wrangler deploy --config wrangler.jsonc --env dev"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@playwright/test": "1.58.2",
    "fake-indexeddb": "^6.2.4",
    "jest": "^30.2.0",
    "vite": "^8.3.1",
    "wrangler": "4.149.0"
  }
}
