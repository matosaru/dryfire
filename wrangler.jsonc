{
  "name": "dryfire",
  "compatibility_date": "2026-10-09",
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "env": {
    "dev": {
      "name": "dryfire-dev",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "404-page",
        "html_handling": "none"
      },
      "workers_dev": true
    }
  },
  "main": "workers/publicSite.js"
}
